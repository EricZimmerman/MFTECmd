<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net472;net10.0</TargetFrameworks>
        <Authors>Eric R. Zimmerman</Authors>
        <Description>MFTECmd</Description>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Version>2026.10.4</Version>
        <LangVersion>10</LangVersion>
        <ApplicationIcon>DatabaseSelectRow.ico</ApplicationIcon>
        <Copyright>Eric R. Zimmerman 2027</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <StartupObject>MFTECmd.Program</StartupObject>
        <!-- Loading a large $MFT keeps millions of objects alive; server GC about halves the load time
             (2.1M records: 10.4 s -> 5.7 s) for ~30% more memory -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="AlphaFS.New" Version="2.3.0" />
        <PackageReference Include="Boot" Version="2026.10.4" />
        <PackageReference Include="Costura.Fody" Version="6.2.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ERZHelpers" Version="2026.10.0" />
        <PackageReference Include="Fody" Version="6.9.3">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="I30" Version="2026.10.4" />
        <PackageReference Include="MFT" Version="2026.10.4" />
        <PackageReference Include="MFT.LogFile" Version="2026.10.4" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="CsvHelper" Version="33.1.0" />
        <PackageReference Include="Exceptionless" Version="6.2.0" />
        <PackageReference Include="Secure" Version="2026.10.4" />
        <PackageReference Include="ServiceStack.Text" Version="10.4.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.13" />
        
        <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.13" />
        <PackageReference Include="Usn" Version="2026.10.4" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <!-- patched versions of vulnerable transitive packages; .NET 10 provides these itself -->
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Private.Uri" Version="4.3.2" />
        <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    </ItemGroup>
</Project>